# APPLICATION
APP_ENV=development
DATA_MODE=live

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/agninetra

# REDIS
REDIS_URL=redis://localhost:6379/0

# NASA FIRMS
FIRMS_MAP_KEY=your_firms_map_key_here
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/

# MOSDAC
MOSDAC_BASE_URL=https://mosdac.gov.in/api/
MOSDAC_USERNAME=your_username
MOSDAC_PASSWORD=your_password

# OSM
OVERPASS_URL=https://overpass-api.de/api/interpreter

# WEATHER
WEATHER_API_KEY=your_weather_api_key
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/

# FRONTEND
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# INGESTION
FIRMS_POLL_INTERVAL_MINUTES=15

# PERSISTENCE
PERSISTENCE_RADIUS_METERS=500
MIN_REPEAT_COUNT=3
MIN_OBSERVATION_SPAN_DAYS=14
MAX_GAP_DAYS=30

# INDUSTRIAL MATCHING
INDUSTRIAL_MATCH_RADIUS_METERS=1000
